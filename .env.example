# Copy to .env and fill in. Never commit .env.

# Database (app connects as the non-superuser role)
POSTGRES_DB=safedocs
POSTGRES_OWNER_USER=safedocs_owner
POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_APP_USER=safedocs_app
POSTGRES_APP_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://safedocs_app:change-me@db:5432/safedocs

# Auth
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_MINUTES=60

# PII vault encryption key (32-byte base64)
PII_VAULT_KEY=change-me

# Policy pack
POLICY_PACK=policy_packs/food_retail.yaml

# LLM provider: fake | ollama | foundry
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_CHAT_DEPLOYMENT=
FOUNDRY_EMBED_DEPLOYMENT=

# Frontend
API_BASE_URL=http://api:8000
